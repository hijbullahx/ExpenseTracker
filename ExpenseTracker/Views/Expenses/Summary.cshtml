@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Expense Summary";
}

<div class="container mt-5">
    <!-- Expense Summary Section -->
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">Expense Summary</h1>
            <p class="lead">View the total expenses grouped by category.</p>
            @if (Model.Any())
            {
                <table class="table table-striped table-bordered">
                    <thead class="thead-dark">
                        <tr>
                            <th>Category</th>
                            <th>Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Category</td>
                                <td>@item.Total.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No expenses recorded yet.</p>
            }
            <a asp-action="Index" class="btn btn-secondary mt-3">Back to Expenses</a>
        </div>
    </div>

    <!-- About the Website Section -->
    <div class="row mt-5">
        <div class="col-12">
            <h2>About Expense Tracker</h2>
            <p>
                The Expense Tracker is a user-friendly web application designed to help individuals manage their personal finances efficiently. Built using ASP.NET Core MVC and Entity Framework Core, it allows users to record, view, and summarize expenses with ease. Key features include adding expenses with categories, viewing detailed expense lists, and generating summaries to track spending patterns.
            </p>
        </div>
    </div>

    <!-- Why It’s Needed Section -->
    <div class="row mt-4">
        <div class="col-12">
            <h2>Why Expense Tracking Matters</h2>
            <p>
                Effective financial management is crucial for achieving personal and professional goals. The Expense Tracker empowers users to monitor their spending, identify trends, and make informed budgeting decisions. Whether you're saving for a big purchase or simply keeping tabs on daily expenses, this tool provides clarity and control over your finances.
            </p>
        </div>
    </div>

